#!/bin/bash
# ============================================
# AUTO-SETUP ALL METABASE BASIC DASHBOARD  QUERIES
# ============================================
# Usage: ./setup-metabase-all-queries <survey_id> <metabase_email> <metabase_password>
# ============================================

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

if [ $# -lt 3 ]; then
    echo -e "${RED}Error: Missing required arguments${NC}"
    echo ""
    echo "Usage: $0 <survey_id> <metabase_email> <metabase_password>"
    echo ""
    echo "Example:"
    echo "  $0 596215 test@gmail.com testpassword"
    echo ""
    echo "This will create ALL 22+ queries from metabase_dashboard_queries.sql"
    exit 1
fi

SURVEY_ID=$1
METABASE_EMAIL=$2
METABASE_PASSWORD=$3
METABASE_URL="${METABASE_URL:-http://localhost:3000}"

echo -e "${CYAN}╔════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║    METABASE DASHBOARD QUERIES AUTO-SETUP                ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════════╝${NC}\n"

echo -e "${BLUE}Survey ID:${NC} $SURVEY_ID"
echo -e "${BLUE}Metabase URL:${NC} $METABASE_URL"


# Step 1: Get question columns for this survey
echo -e "${YELLOW}[1/6]${NC} Getting question structure..."

# Load credentials from .env
if [ -f ".env" ]; then
    while IFS='=' read -r key value; do
        [[ "$key" =~ ^MYSQL_ ]] && export "$key=$value"
    done < <(grep -v '^#' .env | grep -v '^$')
fi

DB_USER="${MYSQL_USER:-surveyapp_user}"
DB_PASS="${MYSQL_PASSWORD:-1234567}"
DB_NAME="${MYSQL_DATABASE:-surveyapp}"

# Get question columns
QUESTION_INFO=$(docker exec -i surveyapp-mysql mysql -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" -N -e "
SELECT GROUP_CONCAT(
  CONCAT(q.qid, ':', q.title, ':', CONCAT('q_', q.sid, 'X', q.gid, 'X', q.qid), ':', q.type)
  SEPARATOR '|'
)
FROM questions q
WHERE q.sid = $SURVEY_ID AND q.parent_qid = 0
ORDER BY q.question_order;
" 2>&1 | grep -v "Warning" | tail -1)

if [ -z "$QUESTION_INFO" ] || [ "$QUESTION_INFO" = "NULL" ]; then
    echo -e "${YELLOW}⚠${NC} No questions found, will create overview queries only"
    QUESTION_INFO=""
else
    QUESTION_COUNT=$(echo "$QUESTION_INFO" | tr '|' '\n' | wc -l | tr -d ' ')
    echo -e "${GREEN}✓${NC} Found $QUESTION_COUNT questions"
fi

# Step 2: Login to Metabase
echo -e "\n${YELLOW}[2/6]${NC} Connecting to Metabase..."
SESSION_RESPONSE=$(curl -s -X POST "$METABASE_URL/api/session" \
  -H "Content-Type: application/json" \
  -d "{\"username\":\"$METABASE_EMAIL\",\"password\":\"$METABASE_PASSWORD\"}" 2>/dev/null)

if echo "$SESSION_RESPONSE" | grep -q "id"; then
    SESSION_ID=$(echo "$SESSION_RESPONSE" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
    echo -e "${GREEN}✓${NC} Connected successfully"
else
    echo -e "${RED}✗ Login failed!${NC}"
    exit 1
fi

# Step 3: Get database
echo -e "\n${YELLOW}[3/6]${NC} Finding database..."
DB_RESPONSE=$(curl -s -X GET "$METABASE_URL/api/database" \
  -H "X-Metabase-Session: $SESSION_ID" 2>/dev/null)

DB_ID=$(echo "$DB_RESPONSE" | grep -o '"name":"surveyapp"[^}]*"id":[0-9]*' | grep -o '"id":[0-9]*' | cut -d':' -f2)

if [ -z "$DB_ID" ]; then
    DB_ID=$(echo "$DB_RESPONSE" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)
    echo -e "${YELLOW}⚠${NC} Using first database (ID: $DB_ID)"
else
    echo -e "${GREEN}✓${NC} Found surveyapp database (ID: $DB_ID)"
fi

# Step 4: Create collections
echo -e "\n${YELLOW}[4/6]${NC} Creating collections..."

create_collection() {
    local name=$1
    local color=$2
    local parent=${3:-null}

    COLL_DATA="{\"name\":\"$name\",\"color\":\"$color\""
    if [ "$parent" != "null" ]; then
        COLL_DATA="$COLL_DATA,\"parent_id\":$parent"
    fi
    COLL_DATA="$COLL_DATA}"

    COLL_RESPONSE=$(curl -s -X POST "$METABASE_URL/api/collection" \
      -H "X-Metabase-Session: $SESSION_ID" \
      -H "Content-Type: application/json" \
      -d "$COLL_DATA" 2>/dev/null)

    echo "$COLL_RESPONSE" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2
}

MAIN_COLL_ID=$(create_collection "Survey $SURVEY_ID - All Queries" "#509EE3")
if [ -n "$MAIN_COLL_ID" ]; then
    echo -e "${GREEN}✓${NC} Created main collection (ID: $MAIN_COLL_ID)"
else
    echo -e "${YELLOW}⚠${NC} Collection may exist, continuing..."
    MAIN_COLL_ID="null"
fi

# Create sub-collections
OVERVIEW_COLL=$(create_collection "1. Overview" "#88BF4D" "$MAIN_COLL_ID")
ANALYSIS_COLL=$(create_collection "2. Analysis" "#EF8C8C" "$MAIN_COLL_ID")
QUESTIONS_COLL=$(create_collection "3. Questions" "#A989C5" "$MAIN_COLL_ID")
MONITORING_COLL=$(create_collection "4. Monitoring" "#F9CF48" "$MAIN_COLL_ID")

echo -e "${GREEN}✓${NC} Created sub-collections"

# Step 5: Parse SQL file and create queries
echo -e "\n${YELLOW}[5/6]${NC} Parsing SQL file and creating queries..."
echo -e "${BLUE}This will take a moment...${NC}\n"

CREATED_COUNT=0
SKIPPED_COUNT=0

# Function to create query in Metabase
create_metabase_query() {
    local name=$1
    local sql=$2
    local description=$3
    local visualization=${4:-table}
    local collection_id=${5:-$MAIN_COLL_ID}

    # Skip if SQL is empty or just comments
    if [ -z "$sql" ] || [[ "$sql" =~ ^[[:space:]]*--.*$ ]]; then
        return 1
    fi

    # Replace survey ID
    sql=$(echo "$sql" | sed "s/596215/$SURVEY_ID/g")
    sql=$(echo "$sql" | sed "s/v_survey_responses_596215/v_survey_responses_$SURVEY_ID/g")

    # Escape for JSON
    sql=$(echo "$sql" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | sed 's/$/\\n/' | tr -d '\n')
    name=$(echo "$name" | sed 's/"/\\"/g')
    description=$(echo "$description" | sed 's/"/\\"/g')

    echo -n "  ${name:0:60}..."

    CARD_RESPONSE=$(curl -s -X POST "$METABASE_URL/api/card" \
      -H "X-Metabase-Session: $SESSION_ID" \
      -H "Content-Type: application/json" \
      -d "{
        \"name\":\"$name\",
        \"description\":\"$description\",
        \"dataset_query\":{
          \"type\":\"native\",
          \"native\":{\"query\":\"$sql\",\"template-tags\":{}},
          \"database\":$DB_ID
        },
        \"display\":\"$visualization\",
        \"visualization_settings\":{},
        \"collection_id\":$collection_id
      }" 2>/dev/null)

    if echo "$CARD_RESPONSE" | grep -q '"id":[0-9]'; then
        CARD_ID=$(echo "$CARD_RESPONSE" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)
        echo -e " ${GREEN}✓${NC}"
        ((CREATED_COUNT++))
        return 0
    else
        echo -e " ${RED}✗${NC}"
        ((SKIPPED_COUNT++))
        return 1
    fi
}

# Parse and create queries from SQL file
echo -e "${CYAN}Section 1: Overview Queries${NC}"

create_metabase_query \
  "[$SURVEY_ID] 1.1 Survey Overview - Main KPIs" \
  "SELECT COUNT(*) as total_surveys, SUM(CASE WHEN is_active = 'Y' THEN 1 ELSE 0 END) as active_surveys, SUM(CASE WHEN is_active = 'N' THEN 1 ELSE 0 END) as inactive_surveys, SUM(total_questions) as total_questions_all_surveys FROM v_survey_overview;" \
  "High-level overview of all surveys" \
  "row" \
  "$OVERVIEW_COLL"

create_metabase_query \
  "[$SURVEY_ID] 1.2 Survey List with Details" \
  "SELECT survey_id, survey_title, status, created_date, start_date, expiry_date, survey_status, total_questions, total_groups, survey_duration_days FROM v_survey_overview WHERE 1=1 ORDER BY created_date DESC;" \
  "All surveys with key information" \
  "table" \
  "$OVERVIEW_COLL"

create_metabase_query \
  "[$SURVEY_ID] 1.3 Response Volume Overview" \
  "SELECT COUNT(*) as total_responses, SUM(is_completed) as completed_responses, SUM(CASE WHEN is_completed = 0 THEN 1 ELSE 0 END) as incomplete_responses, ROUND((SUM(is_completed) / COUNT(*)) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID;" \
  "Key response metrics" \
  "row" \
  "$OVERVIEW_COLL"

create_metabase_query \
  "[$SURVEY_ID] 1.4 Question Type Distribution" \
  "SELECT question_type, question_type_label, COUNT(*) as question_count, SUM(CASE WHEN is_mandatory = 'Yes' THEN 1 ELSE 0 END) as mandatory_count, ROUND((COUNT(*) / (SELECT COUNT(*) FROM v_question_details WHERE survey_id = $SURVEY_ID)) * 100, 2) as percentage FROM v_question_details WHERE survey_id = $SURVEY_ID GROUP BY question_type, question_type_label ORDER BY question_count DESC;" \
  "Breakdown of question types" \
  "pie" \
  "$OVERVIEW_COLL"

create_metabase_query \
  "[$SURVEY_ID] 1.5 Response Trend (30 Days)" \
  "SELECT submission_date, COUNT(*) as responses, SUM(is_completed) as completed, SUM(CASE WHEN is_completed = 0 THEN 1 ELSE 0 END) as incomplete FROM v_survey_responses_$SURVEY_ID WHERE submission_date >= DATE_SUB(CURDATE(), INTERVAL 30 DAY) GROUP BY submission_date ORDER BY submission_date;" \
  "Daily response trend" \
  "line" \
  "$OVERVIEW_COLL"

echo -e "\n${CYAN}Section 2: Analysis Queries${NC}"

create_metabase_query \
  "[$SURVEY_ID] 2.1 Survey Detail - Response Statistics" \
  "SELECT 'Survey $SURVEY_ID' as survey, COUNT(*) as total_responses, SUM(is_completed) as completed, SUM(CASE WHEN response_status = 'In Progress' THEN 1 ELSE 0 END) as in_progress, SUM(CASE WHEN response_status = 'Not Started' THEN 1 ELSE 0 END) as not_started, ROUND(AVG(lastpage), 2) as avg_pages_reached, MIN(submitdate) as first_response, MAX(submitdate) as latest_response FROM v_survey_responses_$SURVEY_ID;" \
  "Detailed response statistics" \
  "table" \
  "$ANALYSIS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 2.2 Response Status Breakdown" \
  "SELECT response_status, COUNT(*) as count, ROUND((COUNT(*) / (SELECT COUNT(*) FROM v_survey_responses_$SURVEY_ID)) * 100, 2) as percentage FROM v_survey_responses_$SURVEY_ID GROUP BY response_status;" \
  "Breakdown by status" \
  "pie" \
  "$ANALYSIS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 2.3 Hourly Response Pattern" \
  "SELECT submission_hour as hour, COUNT(*) as response_count, ROUND(AVG(is_completed) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID WHERE submission_hour IS NOT NULL GROUP BY submission_hour ORDER BY submission_hour;" \
  "Response pattern by hour" \
  "bar" \
  "$ANALYSIS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 2.4 Day of Week Analysis" \
  "SELECT submission_day_of_week as day_of_week, COUNT(*) as response_count, ROUND(AVG(is_completed) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID WHERE submission_day_of_week IS NOT NULL GROUP BY submission_day_of_week, submission_day_number ORDER BY submission_day_number;" \
  "Response pattern by day" \
  "bar" \
  "$ANALYSIS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 2.5 Dropout Analysis" \
  "SELECT lastpage as last_page_reached, COUNT(*) as dropout_count, ROUND((COUNT(*) / (SELECT COUNT(*) FROM v_survey_responses_$SURVEY_ID WHERE is_completed = 0)) * 100, 2) as percentage_of_dropouts FROM v_survey_responses_$SURVEY_ID WHERE is_completed = 0 GROUP BY lastpage ORDER BY dropout_count DESC;" \
  "Where users drop off" \
  "bar" \
  "$ANALYSIS_COLL"

echo -e "\n${CYAN}Section 3: Question Queries${NC}"

create_metabase_query \
  "[$SURVEY_ID] 3.1 Question Catalog" \
  "SELECT question_id, question_code, question_preview, question_type_label, group_name, group_order, question_order, is_mandatory, has_other_option, column_name FROM v_question_details WHERE survey_id = $SURVEY_ID ORDER BY group_order, question_order;" \
  "All questions with metadata" \
  "table" \
  "$QUESTIONS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 3.2 Questions by Group" \
  "SELECT group_name, group_order, COUNT(*) as total_questions, SUM(CASE WHEN is_mandatory = 'Yes' THEN 1 ELSE 0 END) as mandatory_questions, COUNT(DISTINCT question_type) as question_type_variety FROM v_question_details WHERE survey_id = $SURVEY_ID GROUP BY group_name, group_order ORDER BY group_order;" \
  "Question count per group" \
  "table" \
  "$QUESTIONS_COLL"

# Create individual question analysis if we have question info
if [ -n "$QUESTION_INFO" ]; then
    echo -e "\n${CYAN}Creating individual question queries...${NC}"

    # Parse first 3 questions to create example queries
    QUESTION_ARRAY=($(echo "$QUESTION_INFO" | tr '|' '\n' | head -3))

    for Q in "${QUESTION_ARRAY[@]}"; do
        IFS=':' read -r QID QTITLE QCOL QTYPE <<< "$Q"

        if [ -n "$QID" ] && [ -n "$QCOL" ]; then
            create_metabase_query \
              "[$SURVEY_ID] 3.3 Question: $QTITLE" \
              "SELECT $QCOL as response, COUNT(*) as count, ROUND((COUNT(*) / (SELECT COUNT(*) FROM v_survey_responses_$SURVEY_ID WHERE $QCOL IS NOT NULL AND is_completed = 1)) * 100, 2) as percentage FROM v_survey_responses_$SURVEY_ID WHERE $QCOL IS NOT NULL AND is_completed = 1 GROUP BY $QCOL ORDER BY count DESC LIMIT 50;" \
              "Response distribution for $QTITLE" \
              "bar" \
              "$QUESTIONS_COLL"
        fi
    done
fi

echo -e "\n${CYAN}Section 4: Cross-Analysis${NC}"

# Get first two questions for cross-tab if available
if [ -n "$QUESTION_INFO" ]; then
    Q1=$(echo "$QUESTION_INFO" | cut -d'|' -f1 | cut -d':' -f3)
    Q2=$(echo "$QUESTION_INFO" | cut -d'|' -f2 | cut -d':' -f3)
    Q1_TITLE=$(echo "$QUESTION_INFO" | cut -d'|' -f1 | cut -d':' -f2)
    Q2_TITLE=$(echo "$QUESTION_INFO" | cut -d'|' -f2 | cut -d':' -f2)

    if [ -n "$Q1" ] && [ -n "$Q2" ]; then
        create_metabase_query \
          "[$SURVEY_ID] 4.1 Cross-Tab: $Q1_TITLE vs $Q2_TITLE" \
          "SELECT $Q1 as question_1, $Q2 as question_2, COUNT(*) as count FROM v_survey_responses_$SURVEY_ID WHERE is_completed = 1 AND $Q1 IS NOT NULL AND $Q2 IS NOT NULL GROUP BY $Q1, $Q2 ORDER BY count DESC;" \
          "Relationship between two questions" \
          "table" \
          "$ANALYSIS_COLL"
    fi
fi

create_metabase_query \
  "[$SURVEY_ID] 4.2 Response Time vs Completion" \
  "SELECT submission_hour, COUNT(*) as total_started, SUM(is_completed) as completed, ROUND((SUM(is_completed) / COUNT(*)) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID WHERE submission_hour IS NOT NULL GROUP BY submission_hour ORDER BY submission_hour;" \
  "Completion rate by time of day" \
  "line" \
  "$ANALYSIS_COLL"

echo -e "\n${CYAN}Section 5: Monitoring Queries${NC}"

create_metabase_query \
  "[$SURVEY_ID] 5.1 Latest Responses" \
  "SELECT response_id, submitdate, response_status, lastpage, TIMESTAMPDIFF(MINUTE, MIN(submitdate) OVER (), submitdate) as minutes_since_first FROM v_survey_responses_$SURVEY_ID WHERE submitdate IS NOT NULL ORDER BY submitdate DESC LIMIT 20;" \
  "Most recent responses" \
  "table" \
  "$MONITORING_COLL"

create_metabase_query \
  "[$SURVEY_ID] 5.2 Today's Activity" \
  "SELECT HOUR(submitdate) as hour, COUNT(*) as responses, SUM(is_completed) as completed FROM v_survey_responses_$SURVEY_ID WHERE DATE(submitdate) = CURDATE() GROUP BY HOUR(submitdate) ORDER BY hour DESC;" \
  "Responses received today" \
  "bar" \
  "$MONITORING_COLL"

create_metabase_query \
  "[$SURVEY_ID] 5.3 Weekly Summary" \
  "SELECT submission_week as week_number, submission_year as year, COUNT(*) as total_responses, SUM(is_completed) as completed_responses, ROUND((SUM(is_completed) / COUNT(*)) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID WHERE submission_date >= DATE_SUB(CURDATE(), INTERVAL 8 WEEK) GROUP BY submission_week, submission_year ORDER BY submission_year DESC, submission_week DESC;" \
  "Week-over-week comparison" \
  "table" \
  "$MONITORING_COLL"

echo -e "\n${CYAN}Section 6: Data Quality${NC}"

create_metabase_query \
  "[$SURVEY_ID] 6.1 Missing Data Analysis" \
  "SELECT 'Overall' as metric, COUNT(*) as total_responses, COUNT(*) - SUM(is_completed) as incomplete_responses, ROUND(((COUNT(*) - SUM(is_completed)) / COUNT(*)) * 100, 2) as incomplete_percentage FROM v_survey_responses_$SURVEY_ID;" \
  "Data quality metrics" \
  "row" \
  "$ANALYSIS_COLL"

create_metabase_query \
  "[$SURVEY_ID] 6.2 Token Usage" \
  "SELECT CASE WHEN token IS NOT NULL THEN 'Token-based' ELSE 'Anonymous' END as access_type, COUNT(*) as response_count, SUM(is_completed) as completed_count, ROUND((SUM(is_completed) / COUNT(*)) * 100, 2) as completion_rate FROM v_survey_responses_$SURVEY_ID GROUP BY access_type;" \
  "Anonymous vs token-based" \
  "pie" \
  "$ANALYSIS_COLL"

echo -e "\n${CYAN}Section 7: Export${NC}"

create_metabase_query \
  "[$SURVEY_ID] 7.1 Full Data Export" \
  "SELECT * FROM v_survey_responses_$SURVEY_ID WHERE is_completed = 1 ORDER BY submission_date DESC;" \
  "Complete data export" \
  "table" \
  "$MAIN_COLL_ID"

# Step 6: Summary
echo -e "\n${YELLOW}[6/6]${NC} Creating dashboard..."
echo -e "${YELLOW}Note:${NC} Organize queries into dashboards manually for best layout\n"

# Summary
echo -e "${GREEN}╔════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║              SETUP COMPLETE!                        ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════╝${NC}\n"

echo -e "${BLUE} Summary:${NC}"
echo -e "   Queries created: ${GREEN}$CREATED_COUNT${NC}"
echo -e "   Skipped/Failed:  ${YELLOW}$SKIPPED_COUNT${NC}"
echo -e "   Main collection: ${CYAN}Survey $SURVEY_ID - All Queries${NC}\n"

echo -e "${BLUE} Collections:${NC}"
echo -e "   ${CYAN}1. Overview${NC} - Main KPIs and trends"
echo -e "   ${CYAN}2. Analysis${NC} - Detailed breakdowns"
echo -e "   ${CYAN}3. Questions${NC} - Individual question analysis"
echo -e "   ${CYAN}4. Monitoring${NC} - Real-time activity\n"

echo -e "${BLUE} Next steps:${NC}"
echo -e "   1. Open Metabase: ${CYAN}$METABASE_URL${NC}"
echo -e "   2. Navigate to: ${CYAN}Browse → Survey $SURVEY_ID - All Queries${NC}"
echo -e "   3. Explore sub-collections for organized queries"
echo -e "   4. Create dashboards by adding queries\n"

echo -e "${YELLOW} Tips:${NC}"
echo -e "   • Queries are organized by purpose"
echo -e "   • Edit to add parameters: [[AND date >= {{start}}]]"
echo -e "   • Create multiple dashboards for different audiences"
